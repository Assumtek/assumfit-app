# Configuração de produção. Copie para `.env` e preencha.
# NUNCA versione o `.env` preenchido.

# --- Banco
POSTGRES_DB=assumfit
POSTGRES_USER=assumfit
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Sessão
# Dois segredos DIFERENTES. `env.ts` recusa subir em produção se forem iguais
# ou se ainda contiverem o valor de exemplo do compose de desenvolvimento.
# openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Rede
# Precisa ser https em produção — validado na subida. Compõe o redirect_uri do
# OAuth, então tem de bater exatamente com o registrado no Google e na Microsoft.
PUBLIC_URL=https://api.assumfit.com.br
API_DOMAIN=api.assumfit.com.br
# Origens de navegador liberadas, separadas por vírgula. O app nativo não manda
# Origin e não depende disto. Vazio = nenhum navegador autorizado.
CORS_ORIGINS=

# --- Calendário (opcional; sem isto a integração some da tela)
# 32 bytes em hex: openssl rand -hex 32
# Perder esta chave torna os tokens guardados ilegíveis e obriga todo mundo a
# reconectar. Trocá-la tem o mesmo efeito — não há re-cifragem automática.
CALENDAR_ENCRYPTION_KEY=

# console.cloud.google.com > APIs e Serviços > Credenciais > ID do cliente OAuth
# Tipo: aplicativo da Web. Escopo: calendar.readonly
# URI de redirecionamento: https://SEU_DOMINIO/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# portal.azure.com > Microsoft Entra ID > Registros de aplicativo
# Permissão delegada: Calendars.Read, offline_access
# URI de redirecionamento: https://SEU_DOMINIO/calendar/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
