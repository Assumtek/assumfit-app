# O proxy roda em network_mode: host — 127.0.0.1:3001 é a API no mesmo host.
# TLS é automático (ACME) para os três nomes; certificados chegam sozinhos
# quando o DNS de cada um apontar para esta máquina, e renovam sem cron.

# O site institucional — landing e política de privacidade.
assumfit.com.br {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	root * /site
	# /privacidade sem extensão: é a URL que vai nas lojas e no rodapé.
	try_files {path} {path}.html
	file_server
}

www.assumfit.com.br {
	redir https://assumfit.com.br{uri} permanent
}

# A API.
api.assumfit.com.br {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# A política é servida AQUI, não redirecionada: o DNS do domínio raiz ainda
	# aponta para a Hostinger, que segura uma cópia velha do site — este é o
	# único endereço que responde do nosso servidor hoje. Quando o A de
	# assumfit.com.br vier para cá, o raiz vira o canônico de novo.
	root * /site
	@politica path /privacidade
	handle @politica {
		rewrite * /privacidade.html
		file_server
	}
	# Suporte idem: URL exigida pela ficha das lojas, servida daqui enquanto o
	# DNS do raiz não vem.
	@suporte path /suporte
	handle @suporte {
		rewrite * /suporte.html
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
